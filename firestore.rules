rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Spots collection - hitchhiking locations
    match /spots/{spotId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['lat', 'lng', 'createdAt'])
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      // Creator can update any allowed field
      // Any authenticated user can update ONLY validation/rating counters
      // Admin can update anything
      allow update: if request.auth != null
        && (
          // Admin: full access
          request.auth.token.email == 'antoine.v.ville@gmail.com'
          || request.auth.token.email == 'ci-admin@spothitch.com'
          // Creator: can update any field
          || request.auth.uid == resource.data.creatorId
          // Other users: only validation/rating counter fields
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'validationCount', 'testCount', 'ratings', 'averageRating',
               'totalRatings', 'updatedAt', 'lastValidatedAt', 'lastTestedAt'
             ])
        );
      // Only admin can delete spots
      allow delete: if request.auth != null
        && (request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');

      // Spot reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }

      // Spot validations subcollection
      match /validations/{validationId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }

      // Spot comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }
    }

    // Users collection - profiles + friends + friendRequests
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;

      // Friends subcollection
      match /friends/{friendId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null;
      }

      // FriendRequests subcollection
      match /friendRequests/{requestId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
      }

      // Favorites subcollection
      match /favorites/{favId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Trips subcollection
      match /trips/{tripId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Sync data subcollection (localStorage ↔ Firestore sync for multi-device)
      match /syncData/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // FCM tokens subcollection
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Direct Messages
    match /directMessages/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.senderId;
      }
    }

    // Group Conversations
    match /groupConversations/{groupId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.creator;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Usernames index
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Feature Votes — aggregate counters (admin-only writes)
    match /featureVotes/{featureId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && (request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
      allow delete: if request.auth != null
        && request.auth.token.email == 'antoine.v.ville@gmail.com';
    }

    // Feature User Votes — individual votes
    match /featureUserVotes/{voteId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Guide Tips — community travel tips
    match /guideTips/{tipId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.userId
            || request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.userId
            || request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
    }

    // Guide Votes — aggregated guide ratings
    match /guideVotes/{voteKey} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.token.email == 'antoine.v.ville@gmail.com';
    }

    // Hostel Recommendations
    match /hostel_recs/{recId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // User Reviews
    match /userReviews/{targetUid}/reviews/{reviewerUid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == reviewerUid;
      allow delete: if request.auth != null
        && (request.auth.uid == reviewerUid || request.auth.uid == targetUid);
    }

    // Reports — only admin can read/update, any authenticated user can create
    match /reports/{reportId} {
      allow read: if request.auth != null
        && (request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
      allow delete: if false;
    }

    // Roadmap votes
    match /roadmap_votes/{voteId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Roadmap comments
    match /roadmap_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Identity verifications
    match /id_verifications/{verificationId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Guide reports
    match /guide_reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Feature opinions
    match /featureOpinions/{opinionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Per-user guide votes subcollection
    match /users/{userId}/guideVotes/{voteKey} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // SOS Timers — companion mode server-side monitoring
    match /sosTimers/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // SOS Alerts — emergency alerts triggering push notifications
    match /sosAlerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
