rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Spots collection - hitchhiking locations
    match /spots/{spotId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['lat', 'lng', 'createdAt'])
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      // Spots are IMMUTABLE after creation — creator cannot modify
      // Only admin can edit spot core data (coordinates, type, city)
      // Any authenticated user can update ONLY validation/rating counters
      allow update: if request.auth != null
        && (
          // Admin: full access
          request.auth.token.email == 'antoine.v.ville@gmail.com'
          || request.auth.token.email == 'ci-admin@spothitch.com'
          // Any authenticated user: only validation/rating counter fields
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'validationCount', 'testCount', 'ratings', 'averageRating',
               'totalRatings', 'updatedAt', 'lastValidatedAt', 'lastTestedAt',
               'lastValidated', 'lastTested', 'lastValidatedBy', 'lastTestedBy',
               'checkins', 'verified', 'userValidations', 'lastUsed',
               'totalReviews', 'creator', 'reports',
               'lastGpsVerified', 'lastGpsVerifiedBy', 'lastGpsDistance',
               'streetViewVerified', 'streetViewVerifiedBy', 'streetViewVerifiedAt'
             ])
        );
      // Only admin can delete spots
      allow delete: if request.auth != null
        && (request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');

      // Spot reviews subcollection
      // Self-review blocked: creator cannot review their own spot
      // One review per user per spot enforced by reviewId = "{userId}"
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid != resource.data.creatorId
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }

      // Spot validations subcollection
      match /validations/{validationId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }

      // Spot comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }
    }

    // Users collection - profiles + friends + friendRequests
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;

      // Friends subcollection
      // Read: owner + any authenticated user (for mutual friends count)
      // Delete: owner OR the friend themselves
      // Create: owner OR the friend themselves (needed for acceptFriendRequest batch)
      match /friends/{friendId} {
        allow read: if request.auth != null;
        allow delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendId);
        allow create: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendId);
        allow update: if request.auth != null && request.auth.uid == userId;
      }

      // FriendRequests subcollection
      // Read: owner (incoming) OR the sender (to check if already sent)
      // Create: only the sender (requestId must match auth uid)
      // Delete: owner (decline) OR sender (cancel)
      match /friendRequests/{requestId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == requestId);
        allow delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == requestId);
        allow create: if request.auth != null
          && request.auth.uid == requestId
          && request.resource.data.fromUserId == request.auth.uid;
        allow update: if false;
      }

      // Favorites subcollection
      match /favorites/{favId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Trips subcollection
      match /trips/{tripId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Sync data subcollection (localStorage ↔ Firestore sync for multi-device)
      match /syncData/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // FCM tokens subcollection
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Trip history subcollection — owner only
      match /tripHistory/{tripId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Blocked users subcollection — only the owner can read/write
      match /blockedUsers/{blockedUid} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Trip journal subcollection — only the owner can read/write
      match /journal/{tripId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Direct Messages
    match /directMessages/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.senderId;
      }
    }

    // Group Conversations
    // Country groups (country_XX) are readable by all auth users (to check existence before joining)
    // Private groups require membership
    match /groupConversations/{groupId} {
      allow read: if request.auth != null
        && (resource.data.type == 'country' || request.auth.uid in resource.data.members);
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.type == 'country' || request.auth.uid in resource.data.members);
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.creator;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Usernames index
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Feature Votes — aggregate counters (admin-only writes)
    match /featureVotes/{featureId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && (request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
      allow delete: if request.auth != null
        && request.auth.token.email == 'antoine.v.ville@gmail.com';
    }

    // Feature User Votes — individual votes
    match /featureUserVotes/{voteId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Guide Tips — community travel tips
    match /guideTips/{tipId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.userId
            || request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.userId
            || request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
    }

    // Guide Votes — aggregated guide ratings
    match /guideVotes/{voteKey} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.token.email == 'antoine.v.ville@gmail.com';
    }

    // Hostel Recommendations
    match /hostel_recs/{recId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // User Reviews
    match /userReviews/{targetUid}/reviews/{reviewerUid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == reviewerUid;
      allow delete: if request.auth != null
        && (request.auth.uid == reviewerUid || request.auth.uid == targetUid);
    }

    // Reports — only admin can read/update, any authenticated user can create
    match /reports/{reportId} {
      allow read: if request.auth != null
        && (request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
      allow delete: if false;
    }

    // Roadmap votes
    match /roadmap_votes/{voteId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Roadmap comments
    match /roadmap_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Identity verifications
    // Users can read their own; admins can read all + approve/reject (update)
    match /id_verifications/{verificationId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId
            || request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
      allow delete: if false;
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Guide reports
    match /guide_reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Feature opinions
    match /featureOpinions/{opinionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Per-user guide votes subcollection
    match /users/{userId}/guideVotes/{voteKey} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // SOS Timers — guardian mode server-side monitoring
    // Read: owner only (Cloud Functions use admin SDK)
    match /sosTimers/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if request.auth != null
        && request.auth.uid == userId;

      // Messages subcollection — owner writes, any auth user reads
      // (guardians need to read traveler's messages)
      match /messages/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // SOS Real-time Tracking — position shared with guardians during SOS
    match /sosTracking/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // SOS Alerts — emergency alerts triggering push notifications
    match /sosAlerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Community SOS Alerts — broadcast to nearby opted-in users
    match /communityAlerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // Cloud Function updates notifiedCount; clients cannot modify
      allow update, delete: if false;
    }

    // User Locations — approximate position for community SOS alert matching
    match /userLocations/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Proximity Radar
    match /radarUsers/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Events — community meetups and group departures
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.creatorId == request.auth.uid
            || request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
      allow delete: if request.auth != null
        && (resource.data.creatorId == request.auth.uid
            || request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }
    }

    // Friend Challenges — 1v1 challenges between friends
    match /friendChallenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid;
    }

    // Team Challenges — group challenges
    match /teamChallenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid;
    }

    // Activity Feed — shared activity items
    match /activityFeed/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Ambassadors — verified community ambassadors
    match /ambassadors/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid;
      allow delete: if request.auth != null
        && (request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');
    }

    // Travel Buddy Announcements
    match /travelBuddies/{buddyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.token.email == 'antoine.v.ville@gmail.com'
            || request.auth.token.email == 'ci-admin@spothitch.com');

      // Threaded chat messages per announcement
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
        allow delete: if false;
      }
    }

    // Public Trips (shared trip pages, readable by anyone)
    match /publicTrips/{shortId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
