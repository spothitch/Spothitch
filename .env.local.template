# === Firebase (obligatoire pour le dev local avec auth/Firestore) ===
# Trouve ces valeurs sur : https://console.firebase.google.com
# > Ton projet > Paramètres > Général > "Vos applications" > Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# === Sentry (optionnel, pour le suivi d'erreurs) ===
# Trouve cette valeur sur : https://sentry.io > Settings > Projects > spothitch > Client Keys
VITE_SENTRY_DSN=

# === Cloudflare Deploy Hook (optionnel, pour déclencher un rebuild) ===
# Crée le hook sur : Cloudflare Dashboard > Pages > spothitch > Settings > Deploy Hooks
# Puis lance : node scripts/deploy-hook.mjs
CLOUDFLARE_DEPLOY_HOOK_URL=
